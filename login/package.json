{
  "name": "portflow-companion-login",
  "productName": "Companion Login",
  "version": "0.2.0",
  "description": "Logs in to Canvas in its own window and hands the session to Portflow Companion on this computer.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:linux": "electron-builder --linux rpm deb AppImage"
  },
  "author": "Lietze Diderich",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "nl.lietze.companion-login",
    "productName": "Companion Login",
    "files": [
      "main.js",
      "lib.js",
      "updater.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Companion Login",
        "schemes": [
          "portflow-companion"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Companion-Login-Setup.exe"
    },
    "portable": {
      "artifactName": "Companion-Login-portable.exe"
    },
    "linux": {
      "target": [
        "rpm",
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "executableName": "companion-login",
      "maintainer": "Lietze Diderich",
      "syncDesktopName": true
    },
    "rpm": {
      "artifactName": "companion-login.${arch}.rpm"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/ldideric/companion/releases/download/login-latest"
      }
    ],
    "deb": {
      "artifactName": "companion-login_${arch}.deb"
    },
    "appImage": {
      "artifactName": "Companion-Login-${arch}.AppImage"
    }
  },
  "homepage": "https://github.com/ldideric/companion",
  "desktopName": "companion-login.desktop",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
